# Build output. .cargo/config.toml redirects target-dir to local disk anyway,
# but keep this in case someone builds without it.
/target/
**/*.rs.bk

# Recorded telemetry never belongs in the repo: it is large, it is personal,
# and it is regenerated by running the program.
/data/
*.mpseg
*.csv
sessions/

# Local editor / OS noise
.vscode/
.idea/
desktop.ini
Thumbs.db
